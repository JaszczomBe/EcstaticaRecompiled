      "statusBarVisibility": "hidden"
    },
    "variant": {
      "statusBarVisibility": "hidden"
    },
    "ctest": {
      "statusBarVisibility": "hidden"
    },
    "testPreset": {
      "statusBarVisibility": "hidden"
    },
    "cpack": {
      "statusBarVisibility": "hidden"
    },
    "packagePreset": {
      "statusBarVisibility": "hidden"
    },
    "workflow": {
      "statusBarVisibility": "hidden"
    },
    "workflowPreset": {
      "statusBarVisibility": "hidden"
    },
    "debug": {
      "statusBarVisibility": "hidden"
