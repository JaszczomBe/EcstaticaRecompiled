{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ecstatica Recompiled",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--run-recon"
      ],
      "stopAtEntry": false,
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "environment": [
        {
          "name": "E2R_ACTOR_CUES",
          "value": "1"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb"
    }
  ]
}
