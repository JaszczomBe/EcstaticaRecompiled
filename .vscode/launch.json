{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ecstatica Recompiled",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--run-recon"
      ],
      "stopAtEntry": false,
      "postDebugTask": "Ecstatica: Finalize gameplay investigation",
      "setupCommands": [
        {
          "description": "Preserve the running binary and observe debugger stops",
          "text": "source ${workspaceFolder}/scripts/e2-vscode-investigation.py",
          "ignoreFailures": false
        }
      ],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "environment": [
        {
          "name": "E2R_RECORD",
          "value": "auto"
        },
        {
          "name": "E2R_REPLAY",
          "value": ""
        },
        {
          "name": "E2R_INSPECT",
          "value": "1"
        },
        {
          "name": "ASAN_OPTIONS",
          "value": "${env:ASAN_OPTIONS}:detect_leaks=0"
        },
        {
          "name": "E2R_STARTUP_LOGO_DELAY_MS",
          "value": "0"
        },
        {
          "name": "E2R_ACTOR_CYLINDERS",
          "value": "1"
        },
        {
          "name": "E2R_ACTION_INDEX_PROBE",
          "value": "1"
        },
        {
          "name": "E2R_PROXY_MESH_BYPASS",
          "value": "1"
        },
        {
          "name": "E2R_DEFER_BACKGROUND_SPAWNS",
          "value": "0"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "Ecstatica: Full regression suite",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica: Full regression suite \u2014 visible SDL",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --display visible",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Source, tools and original contracts",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block checks --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Startup",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block startup --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Movement and courtyard",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block movement --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Unarmed combat and damage",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block unarmed --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Workshop, sword combat and doors",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block workshop --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Potions and equipment",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block potions --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Swimming",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block swimming --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Menus",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block menus --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Mixed gameplay stability",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block stability --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Ecstatica suite: Complete replay corpus",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --block replay --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "e2SuiteDisplay",
      "type": "pickString",
      "description": "Regression gameplay display (scenarios run one at a time)",
      "options": [
        "headless",
        "visible"
      ],
      "default": "headless"
    }
  ]
}
