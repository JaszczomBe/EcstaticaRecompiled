{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "\u2605 Ecstatica Recompiled",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [
        "--run-recon"
      ],
      "stopAtEntry": false,
      "postDebugTask": "Ecstatica: Finalize gameplay investigation",
      "setupCommands": [
        {
          "description": "Preserve the running binary and observe debugger stops",
          "text": "source ${workspaceFolder}/scripts/e2-vscode-investigation.py",
          "ignoreFailures": false
        }
      ],
      "cwd": "${command:cmake.getLaunchTargetDirectory}",
      "environment": [
        {
          "name": "E2R_RECORD",
          "value": "auto"
        },
        {
          "name": "E2R_REPLAY",
          "value": ""
        },
        {
          "name": "E2R_INSPECT",
          "value": "1"
        },
        {
          "name": "ASAN_OPTIONS",
          "value": "${env:ASAN_OPTIONS}:detect_leaks=0"
        },
        {
          "name": "E2R_TEST_POPULATION",
          "value": ""
        },
        {
          "name": "E2R_STARTUP_LOGO_DELAY_MS",
          "value": "5000"
        },
        {
          "name": "E2R_ACTOR_CYLINDERS",
          "value": "1"
        },
        {
          "name": "E2R_ACTION_INDEX_PROBE",
          "value": "1"
        },
        {
          "name": "E2R_PROXY_MESH_BYPASS",
          "value": "1"
        },
        {
          "name": "E2R_PLAYER_MESH",
          "value": "1"
        },
        {
          "name": "E2R_NPC_MESH",
          "value": "1"
        },
        {
          "name": "E2R_OBJECT_MESH_IDS",
          "value": "5,259,264,265,266,536,537,601,603,608,663,710,711,737,908,909,912,963,980,1028,1085,1100,1101,1122,1123,1124,1125,1127,1128,1129,1130,1131,1153,1188,1190,1191,1192,1193,2628,3199,3251,3551,3717,3737,3782,3820,3821,3822,3986,3994,3995,3996,3997,3998,3999,4000,4001"
        },
        {
          "name": "E2R_OBJECT_MESH_REPS",
          "value": "66,67,86,102,103,126,133,134,135,153,271,277,279,282,287,349"
        },
        {
          "name": "E2R_DEFER_BACKGROUND_SPAWNS",
          "value": "0"
        }
      ],
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "\u2605 Reggression Suite FULL (Debug + ASan)",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 01: Source, tools and original contracts",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block checks",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 02: Startup",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block startup --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 03: Menus",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block menus --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 04: Movement and courtyard",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block movement --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 05: Unarmed combat and damage",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block unarmed --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 06: Workshop, sword combat and doors",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block workshop --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 07: Swimming",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block swimming --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 08: Potions and equipment",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block potions --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 09: Mixed gameplay stability",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block stability --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 10: Complete replay corpus",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block replay --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Regression 11: Game save and load",
      "type": "node-terminal",
      "request": "launch",
      "command": "python3 \"${workspaceFolder}/scripts/run-e2-suite.py\" --build --configurations debug asan --execution shared --block persistence --display ${input:e2SuiteDisplay}",
      "cwd": "${workspaceFolder}"
    }
  ],
  "inputs": [
    {
      "id": "e2SuiteDisplay",
      "type": "pickString",
      "description": "Gameplay windows (Debug and ASan run concurrently)",
      "options": [
        "headless",
        "visible-debug",
        "visible-asan",
        "visible-both"
      ],
      "default": "headless"
    }
  ]
}
