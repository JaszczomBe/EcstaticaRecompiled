{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build selected preset",
      "type": "cmake",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "targets": [
        "e2recomp"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
