{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build selected preset",
      "type": "cmake",
      "command": "build",
      "preset": "${command:cmake.activeBuildPresetName}",
      "targets": [
        "e2recomp"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Ecstatica: Finalize gameplay investigation",
      "type": "process",
      "command": "python3",
      "args": ["${workspaceFolder}/scripts/e2_f5.py", "--pending"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "silent", "panel": "dedicated"}
    }
  ]
}
