      "binaryDir": "${sourceDir}/build/linux-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "ECSTATICA2_DATA_DIR": "/home/rgrabowski/Games/Ecstatica2"
      }
    },
    {
      "name": "linux-clang32-debug",
      "displayName": "Linux Clang 32-bit Debug",
